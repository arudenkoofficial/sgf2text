{
  "name": "sgf2text",
  "version": "0.1.0",
  "description": "Convert SGF Go game records into screen-reader friendly text",
  "keywords": [
    "sgf",
    "go",
    "baduk",
    "weiqi",
    "accessibility",
    "screen-reader"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arudenkoofficial/sgf2text.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "typecheck:web": "tsc --noEmit --project web/tsconfig.json",
    "build:web": "esbuild web/main.ts --bundle --format=esm --minify --alias:fs=./web/shims/node-empty.js --alias:buffer=./web/shims/node-empty.js --alias:string_decoder=./web/shims/node-empty.js --alias:iconv-lite=./web/shims/node-empty.js --alias:jschardet=./web/shims/node-empty.js --outfile=web/dist/main.js"
  },
  "dependencies": {
    "@sabaki/go-board": "^1.4.3",
    "@sabaki/sgf": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
