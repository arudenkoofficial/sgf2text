{
  "name": "sgf2text-repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sgf2text",
    "web"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace sgf2text && tsc --noEmit --project web/test",
    "build": "npm run build --workspace sgf2text",
    "pretypecheck:web": "npm run build",
    "typecheck:web": "tsc --noEmit --project web",
    "build:web": "npm run build --workspace sgf2text-web"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
